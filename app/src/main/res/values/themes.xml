<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PixelCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F7F2EA</item>
    </style>

    <style name="Theme.PixelCraft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F2EA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelCraft</item>
    </style>
</resources>
